# Stage 1: build the pygbag bundle from the LabHero source tree.
FROM docker.io/library/python:3.11-slim AS bundler

ENV PIP_DISABLE_PIP_VERSION_CHECK=1

RUN pip install --no-cache-dir pygbag==0.9.3

WORKDIR /src
COPY . .

# `--build` builds the bundle into ./build/web and exits without serving.
# `--ume_block 0` silences the user-media-engine warning in headless builds.
RUN python -m pygbag --build --ume_block 0 .

# Pygbag emits a fixed src.tar.gz URL. Fingerprint that heavy archive so nginx
# can give it a long immutable cache lifetime without serving stale game code
# after a deployment. index.html is patched to reference the hashed filename.
RUN python deploy/fingerprint_web_bundle.py build/web


# Stage 2: serve the bundle + reverse-proxy /api to the backend.
FROM docker.io/library/nginx:1.27-alpine

# Local Docker Compose keeps deploy/nginx.conf by default. Darwin/Podman passes
# --build-arg NGINX_CONF=deploy/nginx.podman.conf so both containers can talk
# over the shared pod network namespace via 127.0.0.1.
ARG NGINX_CONF=deploy/nginx.conf
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf

COPY --from=bundler /src/build/web/ /usr/share/nginx/html/

EXPOSE 80
